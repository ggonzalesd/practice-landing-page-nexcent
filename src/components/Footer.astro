---
import { Image } from 'astro:assets';
import EmailForm from './ui/EmailForm.astro';
import FooterSubsections from './ui/FooterSubsections.astro';
import Logo from './ui/Logo.astro';

import facebookLogo from '@/assets/logos/facebook.svg';
import instagramLogo from '@/assets/logos/instagram.svg';
import twitterLogo from '@/assets/logos/twitter.svg';
import youtubeLogo from '@/assets/logos/youtube.svg';

const socialMedia: Array<{
  path: string;
  alt: string;
  SocialLogo: ImageMetadata;
}> = [
  {
    path: 'https://instagram.com/#',
    alt: 'Instagram',
    SocialLogo: instagramLogo,
  },
  {
    path: 'https://facebook.com/#',
    alt: 'Facebook',
    SocialLogo: facebookLogo,
  },
  {
    path: 'https://twitter.com/#',
    alt: 'Twitter',
    SocialLogo: twitterLogo,
  },
  {
    path: 'https://youtube.com',
    alt: 'Youtube',
    SocialLogo: youtubeLogo,
  },
];

type LinkType = {
  href: string;
  display: string;
};

const company: Array<LinkType> = [
  { href: '/about', display: 'About Us' },
  { href: '/blog', display: 'Blog' },
  { href: '/contact', display: 'Contact Us' },
  { href: '/pricing', display: 'Pricing' },
  { href: '/testimonial', display: 'Testimonial' },
];

const support: Array<LinkType> = [
  { href: '/help', display: 'Help center' },
  { href: '/terms-of-service', display: 'Terms of Service' },
  { href: '/legal', display: 'Legal' },
  { href: '/policy', display: 'Privacy policy' },
  { href: '/status', display: 'Status' },
];
---

<footer class='bg-slate-800 py-14 text-white'>
  <div
    class='container flex flex-col-reverse justify-between gap-8 sm:flex-row'
  >
    <div class='flex flex-col items-center gap-8 sm:items-start'>
      <Logo class='text-zinc-200' size='big' />
      <div class='flex flex-col'>
        <span>Copyright © 2020 Nexcent Itd.</span>
        <span>All rights reserved</span>
      </div>
      <div class='flex gap-2'>
        {
          socialMedia.map(({ path, alt, SocialLogo }) => (
            <a href={path} class='rounded-full bg-slate-700 p-2'>
              <span class='sr-only'>{alt}</span>
              <Image src={SocialLogo} alt='' />
            </a>
          ))
        }
      </div>
    </div>
    <div class='flex flex-col gap-10 sm:flex-row'>
      <FooterSubsections title='Company'>
        {
          company.map(({ display, href }) => (
            <a class='text-sm text-slate-300' href={href}>
              {display}
            </a>
          ))
        }
      </FooterSubsections>
      <FooterSubsections title='Support'>
        {
          support.map(({ display, href }) => (
            <a class='text-sm text-slate-300' href={href}>
              {display}
            </a>
          ))
        }
      </FooterSubsections>
      <FooterSubsections title='Stay up to date'>
        <EmailForm />
      </FooterSubsections>
    </div>
  </div>
</footer>
