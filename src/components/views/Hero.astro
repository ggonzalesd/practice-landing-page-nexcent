---
import { Image } from 'astro:assets';
import LinkButton from '../LinkButton.astro';

import heroImage from '@/assets/images/hero.svg';
---

<section class='bg-zinc-100'>
  <div class='container flex flex-col items-center py-24'>
    <div class='flex w-full flex-col justify-between sm:flex-row'>
      <div class='flex flex-col gap-6'>
        <h1
          class='max-w-[15ch] text-center text-7xl font-bold text-zinc-700 sm:text-left'
        >
          Lessons and insights <span class='text-green-500'>from 8 years</span>
        </h1>
        <p class='text-center text-zinc-500 sm:text-left'>
          where to grow your business as a photographer: site or social media?
        </p>
        <div class='flex justify-center sm:justify-start'>
          <LinkButton class='inline-flex px-7 py-3'> Register </LinkButton>
        </div>
      </div>
      <div class='flex flex-grow justify-center'>
        <Image src={heroImage} alt='Hero' />
      </div>
    </div>
    <div class='flex justify-center gap-2'>
      <div class='aspect-square size-2 rounded-full bg-green-500'></div>
      <div class='aspect-square size-2 rounded-full bg-green-700/25'></div>
      <div class='aspect-square size-2 rounded-full bg-green-700/25'></div>
    </div>
  </div>
</section>
