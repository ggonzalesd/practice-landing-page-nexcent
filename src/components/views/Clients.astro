---
import { Image } from 'astro:assets';
import { clientList } from '@/constants/clients.constants';
import SimpleSection from '../ui/SimpleSection.astro';
---

<SimpleSection
  title='Our Clients'
  description='We have been working with some Fortune 500+ clients'
  class='flex-col items-center'
>
  <div class='flex w-full flex-wrap justify-around gap-2'>
    {
      clientList.map(({ alt, src }) => (
        <Image
          class='aspect-square object-contain object-center'
          alt={alt}
          src={src}
        />
      ))
    }
  </div>
</SimpleSection>
