---
import helpPeople from '@/assets/icons/help-people.svg';
import helpOther from '@/assets/icons/help-other.svg';
import helpTouch from '@/assets/icons/help-touch.svg';
import helpPayment from '@/assets/icons/help-payment.svg';
import { Image } from 'astro:assets';

const numbers = [
  {
    value: 2_245_341,
    display: 'Members',
    icon: helpPeople,
  },
  {
    value: 46_328,
    display: 'Clubs',
    icon: helpOther,
  },
  {
    value: 828_867,
    display: 'Event Booking',
    icon: helpTouch,
  },
  {
    value: 1_926_436,
    display: 'Payments',
    icon: helpPayment,
  },
];
---

<section class='bg-zinc-100'>
  <div class='container my-5 grid grid-cols-2 py-10'>
    <div class='flex flex-grow flex-col gap-2'>
      <h2 class='text-4xl font-bold text-zinc-700'>
        Helping a local <br />
        <span class='text-green-600'>business reinvent itself</span>
      </h2>
      <p>We reached here with our hard work and dedication</p>
    </div>
    <div class='grid grid-cols-2 gap-4'>
      {
        numbers.map(({ display, icon, value }) => (
          <div class='flex size-full items-center justify-center'>
            <div class='flex min-w-44 items-center gap-3'>
              <Image
                src={icon}
                alt={display}
                class='aspect-square size-10 object-contain object-center'
              />
              <div class='flex flex-col'>
                <span class='text-md font-bold text-zinc-700'>
                  {value.toLocaleString()}
                </span>
                <span class='text-xs text-zinc-600'>{display}</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
