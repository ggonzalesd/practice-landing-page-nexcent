---
interface Props {
  title: string;
  description: string;
  class?: string;
}

const { title, description, class: className } = Astro.props;
---

<section>
  <div class:list={['container flex gap-8 py-10', className]}>
    <div class='flex flex-grow flex-col gap-4'>
      <h2 class='max-w-[24ch] text-center text-5xl font-bold text-zinc-700'>
        {title}
      </h2>
      <p class='text-center text-zinc-600'>
        {description}
      </p>
    </div>
    <slot />
  </div>
</section>
