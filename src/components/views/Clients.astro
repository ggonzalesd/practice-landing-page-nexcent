---
import { clientList } from '@/constants/clients.constants';
import { Image } from 'astro:assets';
---

<section>
  <div class='container flex flex-col gap-4 py-10'>
    <h2 class='text-center text-5xl font-bold text-zinc-700'>Our Clients</h2>
    <p class='text-center text-zinc-600'>
      We have been working with some Fortune 500+ clients
    </p>
    <div class='flex flex-wrap justify-around gap-2 pt-4'>
      {
        clientList.map(({ alt, src }) => (
          <Image
            class='aspect-square object-contain object-center'
            alt={alt}
            src={src}
          />
        ))
      }
    </div>
  </div>
</section>
